@model List<EntryDto>
@{
    ViewData["Title"] = "My entries";
}
<div class="container">
    <div class="rd-page-header">
        <h1>My entries</h1>
        <div class="sub">Every event you've entered and where it stands.</div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3 small">
        <span class="status-badge status-confirmed">Confirmed</span> <span class="text-secondary">upcoming and locked in</span>
        <span class="status-badge status-awaiting ms-2">Awaiting Results</span> <span class="text-secondary">event done, waiting for the organiser</span>
        <span class="status-badge status-completed ms-2">Completed</span> <span class="text-secondary">result recorded</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rd-card">
            <div class="empty-state">
                <div class="big">No entries yet</div>
                <p>Find an event you like and pick a category.</p>
                <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Browse events</a>
            </div>
        </div>
    }
    else
    {
        <div class="rd-table-wrap">
            <div class="table-responsive">
                <table class="table rd-table table-hover">
                    <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Status</th><th>Finish</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a class="fw-semibold text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">@e.EventName</a></td>
                            <td>@Fmt.Date(e.EventDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.EventLocation) ? "-" : e.EventLocation)</td>
                            <td>@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td>
                                @if (e.FinishTime.HasValue)
                                {
                                    <span>@Fmt.Time(e.FinishTime)</span>
                                    @if (e.Position.HasValue) { <span class="text-secondary small">(@Fmt.Ordinal(e.Position.Value))</span> }
                                }
                                else { <span class="text-secondary">-</span> }
                            </td>
                            <td class="text-end">
                                @if (e.Status != "Completed")
                                {
                                    <form asp-action="Withdraw" asp-route-id="@e.EventEntryID" method="post" class="d-inline"
                                          onsubmit="return confirm('Withdraw from this event?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
