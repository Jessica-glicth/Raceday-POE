@model EventFormViewModel
@{
    var isEdit = Model.EventID.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}
<div class="container">
    <div class="rd-page-header">
        <a asp-action="Events" class="small text-decoration-none">&larr; My events</a>
        <h1 class="mt-2">@(isEdit ? "Edit event" : "Create event")</h1>
    </div>

    <div class="rd-card">
        <div class="rd-card-body p-4">
            <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="HasBanner" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" maxlength="100" />
                        <span asp-validation-for="EventName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" maxlength="100" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="BannerFile" class="form-label"></label>
                        @if (isEdit && Model.HasBanner)
                        {
                            <div class="mb-2">
                                <img src="@Url.Action("EventBanner", "Images", new { id = Model.EventID })" alt="Current banner" class="rounded" style="max-height:140px" />
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="RemoveBanner" />
                                    <label class="form-check-label small" asp-for="RemoveBanner">Remove the current banner (ignored if you upload a new one)</label>
                                </div>
                            </div>
                        }
                        <input asp-for="BannerFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />
                        <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. Shown on the event page.</div>
                        <span asp-validation-for="BannerFile" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-rd-outline" asp-action="Events">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
